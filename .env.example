# Copie para .env e preencha. O .env nunca vai para o Git.
PORT=3000
HOST=127.0.0.1                    # em hospedagem use 0.0.0.0
DB_PATH=                          # caminho persistente do SQLite em produção
SEND_MODE=dry                      # dry = simula; live = envia de verdade

# Marca (whitelabel). Padrão: brand.json. Para outra marca, aponte para outro arquivo.
BRAND_FILE=
LOJA_NOME=                         # nome da loja que assina as mensagens (vale mais que loja.nome do brand.json)
# Login do painel (Supabase Auth do PDV). Vale mais que auth em brand.json.
AUTH_SUPABASE_URL=
AUTH_SUPABASE_KEY=                 # chave publicável sb_publishable_...

# Pedidos pagos do PDV (a chave secreta fica somente no servidor do CRM)
PDV_SUPABASE_URL=
# Prefira a nova chave sb_secret_...; a service_role legada continua aceita durante a migração.
PDV_SUPABASE_SECRET_KEY=
PDV_SUPABASE_SERVICE_ROLE_KEY=
PDV_SUPABASE_SCHEMA=               # vazio = pdv.schema do brand.json
PDV_BACKFILL_DAYS=400

# Mantido somente para ferramentas antigas de importação histórica; não é usado na sincronização normal.
SAIPOS_TOKEN=
WA_TOKEN=
WA_PHONE_ID=
WA_WABA_ID=
WA_APP_ID=
ANTHROPIC_API_KEY=

# Cópia dos dados no Supabase (projeto da loja, de preferência em São Paulo)
SUPABASE_URL=https://hwcpphocovmabkqzntdk.supabase.co
SUPABASE_KEY=sb_publishable_aYhEazzbCnwyKCKe45kLBw_0GCpHicu                      # chave pública; as RLS protegem os dados
SUPABASE_CRM_SECRET=               # segredo do CRM; o banco guarda só o SHA-256 em private.crm_ok(). Nunca publique.

# SMS pela Zenvia (cobrado por mensagem)
ZENVIA_TOKEN=
ZENVIA_FROM=
# E-mail pelo Resend (o domínio do EMAIL_FROM precisa estar verificado no Resend)
RESEND_API_KEY=
EMAIL_FROM=Minha Loja <contato@minhaloja.com.br>
EMAIL_REPLY_TO=

# Meta Ads e Instagram. Se META_TOKEN ficar vazio, o CRM usa WA_TOKEN.
META_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v21.0

# Google Meu Negócio e Google Ads
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_TOKEN_PATH=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21
